# Anthropic: the SDK reads ANTHROPIC_API_KEY (or an `ant auth login` profile).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same value in the webhook configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

BUSINESS_FILE=examples/business.example.json
PORT=3000
